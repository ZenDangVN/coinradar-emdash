---
// CMS page detail (/pages/<slug>/). Server-rendered off the EmDash `pages` collection (D1) so
// editor-created pages get a route without touching code. Renders the Portable Text content in a
// centred reading column styled like the blog article prose (.blog-prose), inside the theme shell.
import siteData from "@config/siteData.json";
import { portableTextToPlain } from "@js/blogData";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getEmDashEntry } from "emdash";
import { PortableText } from "emdash/ui";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { entry: page, cacheHint } = await getEmDashEntry("pages", slug);
if (!page) return Astro.redirect("/404");
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// meta description: the first ~160 chars of the body (pages have no excerpt field)
const description = portableTextToPlain(page.data.content).slice(0, 160);
---

<BaseLayout title={`${page.data.title} — ${siteData.name}`} description={description}>
  <div class="site-container py-8 md:py-12">
    <article class="mx-auto flex max-w-[800px] flex-col gap-8">
      <h1 class="h1 text-foreground text-balance" {...page.edit.title}>{page.data.title}</h1>
      <div class="blog-prose" {...page.edit.content}>
        <PortableText value={page.data.content} />
      </div>
    </article>
  </div>
</BaseLayout>
