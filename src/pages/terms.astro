---
// Terms & Conditions (/terms). Thin route shell: owns BaseLayout + SEO; content lives in
// @config/legalData and renders through the shared Sections/Legal/LegalArticle.
import LegalArticle from "@components/Sections/Legal/LegalArticle.astro";
import legalData from "@config/legalData.json";
import { getSiteIdentity } from "@js/siteIdentity";
import BaseLayout from "@layouts/BaseLayout.astro";

const page = legalData.terms;

const site = await getSiteIdentity();
---

<BaseLayout title={`${page.title} — ${site.name}`} description={page.description}>
  <LegalArticle page={page} />
</BaseLayout>
