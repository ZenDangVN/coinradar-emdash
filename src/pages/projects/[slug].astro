---
// Project detail (/projects/<slug>/). Thin route shell: owns BaseLayout + SEO and composes the Figma
// "project-realtime-chat" frame (node 72:191) via <ProjectArticle>. Server-rendered: the project
// comes from the EmDash `projects` collection (D1) at request time — no getStaticPaths — and the
// Portable Text overview renders through <PortableText> into ProjectArticle's slot. `toProjectCard`
// builds the listing links off the SAME slug, so grid links and routes can never drift.
import ProjectArticle from "@components/Sections/Project/ProjectArticle.astro";
import { getSiteIdentity } from "@js/siteIdentity";
import { getProject } from "@js/projectData";
import BaseLayout from "@layouts/BaseLayout.astro";
import { PortableText } from "emdash/ui";

const { slug } = Astro.params;
if (!slug) return Astro.redirect("/404");

const { project: entry, cacheHint } = await getProject(slug);
if (!entry) return Astro.redirect("/404");
const site = await getSiteIdentity();

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
---

<BaseLayout
  title={`${entry.data.title} — ${site.name}`}
  description={entry.data.description}
  image={entry.data.thumbnail}
>
  <div class="site-container flex flex-col gap-10 py-8 md:gap-12 md:py-12">
    <ProjectArticle project={entry.data}>
      <PortableText value={entry.data.body} />
    </ProjectArticle>
  </div>
</BaseLayout>
