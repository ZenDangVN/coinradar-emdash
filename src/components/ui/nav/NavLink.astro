---
import type { HTMLAttributes } from "astro/types";
import { tv, type VariantProps } from "tailwind-variants";

type Props = HTMLAttributes<"a"> & VariantProps<typeof navLink> & { href: string };

export const navLink = tv({
  base: [
    "inline-flex items-center gap-2 text-sm font-semibold transition-all duration-200",
    "text-gray-400 hover:text-white outline-none focus-visible:ring-2 focus-visible:ring-cyan-400",
    "aria-[current=page]:text-cyan-400",
  ],
  variants: {
    variant: {
      underline:
        "border-b-2 border-transparent px-1 py-2 hover:border-cyan-400/50 aria-[current=page]:border-cyan-400",
      pills:
        "rounded-full px-3.5 py-1.5 hover:bg-gray-800 hover:text-white aria-[current=page]:bg-cyan-500/10 aria-[current=page]:text-cyan-400 aria-[current=page]:border aria-[current=page]:border-cyan-500/30",
      segment:
        "rounded-lg px-3 py-1.5 hover:bg-gray-800 aria-[current=page]:bg-gray-800 aria-[current=page]:text-white",
      retro: [
        "px-3 py-1.5 rounded-md text-sm font-medium",
        "text-gray-300 hover:text-cyan-400 aria-[current=page]:text-cyan-400",
      ],
    },
  },
  defaultVariants: { variant: "pills" },
});

const { variant, href, class: className, ...rest } = Astro.props;
---

<a href={href} class={navLink({ variant, class: className })} data-slot="nav-link" {...rest}>
  <slot />
</a>
