---
interface Props {
  activeCategory?: string;
}
const { activeCategory = "all" } = Astro.props as Props;
---

<div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 py-4 my-2">
  <div class="flex flex-wrap items-center gap-2">
    <a
      href="/blog/"
      class={`rounded-full px-4 py-1.5 text-xs font-semibold transition ${
        activeCategory === "all"
          ? "bg-cyan-500/10 text-cyan-400 border border-cyan-500/30"
          : "bg-gray-900 border border-white/10 text-gray-300 hover:text-white hover:border-white/20"
      }`}
    >
      Tất Cả Bài Viết
    </a>
    <a
      href="/blog/?category=scam"
      class={`rounded-full px-4 py-1.5 text-xs font-semibold transition ${
        activeCategory === "scam"
          ? "bg-red-500/10 text-red-400 border border-red-500/30"
          : "bg-gray-900 border border-white/10 text-gray-300 hover:text-white hover:border-white/20"
      }`}
    >
      🚨 Cảnh Báo Scam
    </a>
    <a
      href="/blog/?category=analysis"
      class={`rounded-full px-4 py-1.5 text-xs font-semibold transition ${
        activeCategory === "analysis"
          ? "bg-cyan-500/10 text-cyan-400 border border-cyan-500/30"
          : "bg-gray-900 border border-white/10 text-gray-300 hover:text-white hover:border-white/20"
      }`}
    >
      📊 Phân Tích On-Chain
    </a>
    <a
      href="/blog/?category=security"
      class={`rounded-full px-4 py-1.5 text-xs font-semibold transition ${
        activeCategory === "security"
          ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/30"
          : "bg-gray-900 border border-white/10 text-gray-300 hover:text-white hover:border-white/20"
      }`}
    >
      🛡️ Bảo Mật Ví & Web3
    </a>
    <a
      href="/blog/?category=news"
      class={`rounded-full px-4 py-1.5 text-xs font-semibold transition ${
        activeCategory === "news"
          ? "bg-sky-500/10 text-sky-400 border border-sky-500/30"
          : "bg-gray-900 border border-white/10 text-gray-300 hover:text-white hover:border-white/20"
      }`}
    >
      ⚡ Tin Tức Thị Trường
    </a>
  </div>

  <div class="text-xs text-gray-400 font-mono">
    Sắp xếp: <strong class="text-white">Mới nhất</strong>
  </div>
</div>
