---
import HeaderNavLinks from "@components/Sections/Global/HeaderNavLinks.astro";
import { Nav } from "@components/ui/nav";
import { Sheet } from "@components/ui/sheet";
import { getSiteIdentity } from "@js/siteIdentity";
import { getFeaturedCrisisPost } from "@js/blogData";
import { getBinancePrices, DEFAULT_COIN_SYMBOLS } from "@js/cryptoPrices";
import CoinSelectorModal from "@components/Sections/Global/CoinSelectorModal.astro";

const pathname = Astro.url.pathname;
const { name: siteName } = await getSiteIdentity();

// Read user's selected coins from cookies
const savedCoinsCookie = Astro.cookies.get("coinradar_selected_coins")?.value;
const isFirstVisit = !Astro.cookies.has("coinradar_selected_coins");

const selectedCoins = savedCoinsCookie
  ? savedCoinsCookie.split(",").map((s) => s.trim().toUpperCase()).filter(Boolean)
  : [...DEFAULT_COIN_SYMBOLS];

const [{ post: crisisPost }, cryptoTickers] = await Promise.all([
  getFeaturedCrisisPost(),
  getBinancePrices(selectedCoins),
]);

// Determine if we need an automatic horizontal slider (> 5 coins) or static display (<= 5 coins)
const isSliderMode = cryptoTickers.length > 5;
const activePairs = cryptoTickers.map((t) => `${t.symbol}USDT`);
---

<!-- 1. TOP TICKER & BREAKING ALERTS -->
<div class="bg-[#06090e] border-b border-white/5 py-1.5 text-xs overflow-hidden">
  <div class="site-container flex flex-wrap items-center justify-between gap-3">
    <!-- Breaking Alert / Monitor Status -->
    <div class="flex items-center gap-2 overflow-hidden text-ellipsis whitespace-nowrap max-w-full sm:max-w-[42%] lg:max-w-[48%] shrink-0">
      <span class="inline-flex items-center gap-1 rounded bg-red-600 px-2 py-0.5 text-[10px] font-extrabold uppercase tracking-wider text-white animate-pulse shrink-0">
        ⚠️ KHẨN CẤP
      </span>
      {crisisPost ? (
        <a href={`/blog/${crisisPost.id}/`} class="text-red-300/90 text-xs hover:text-white hover:underline truncate">
          {crisisPost.data.title}
        </a>
      ) : (
        <span class="text-red-300/90 text-xs truncate">
          Hệ thống CoinRadar Radar đang theo dõi 24/7 trên 12 mạng lưới blockchain
        </span>
      )}
    </div>
    
    <!-- Real-time Binance Crypto Ticker with Slider / Static Switch -->
    <div
      class="hidden sm:flex items-center gap-2 font-mono text-[11px] text-gray-400 overflow-hidden max-w-full sm:max-w-[56%] lg:max-w-[50%]"
      id="binance-ticker-bar"
      data-pairs={JSON.stringify(activePairs)}
    >
      <!-- Live Indicator + Customize Button -->
      <div class="flex items-center gap-1.5 shrink-0 pr-1 border-r border-white/10 mr-1">
        <div class="flex items-center gap-1 text-[10px] text-gray-400 uppercase tracking-wider">
          <span class="size-1.5 rounded-full bg-emerald-400 animate-ping mr-0.5"></span>
          <span class="hidden md:inline font-sans">Binance:</span>
        </div>

        <!-- Customize button to re-open selection modal -->
        <button
          type="button"
          data-open-coin-modal
          class="flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] bg-white/5 hover:bg-cyan-500/20 text-gray-400 hover:text-cyan-300 border border-white/10 hover:border-cyan-500/30 transition-all cursor-pointer"
          title="Tùy chọn danh sách Coin hiển thị"
        >
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/>
            <circle cx="12" cy="12" r="3"/>
          </svg>
          <span class="font-sans text-[10px] hidden md:inline">Tùy chọn</span>
        </button>
      </div>

      <!-- Ticker Items Display -->
      {isSliderMode ? (
        <!-- Horizontal Infinite Auto-Slider Mode (> 5 coins) -->
        <div class="ticker-slider-wrapper relative overflow-hidden flex-1 group">
          <!-- Gradient Masks -->
          <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-4 bg-gradient-to-r from-[#06090e] to-transparent z-10"></div>
          <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-4 bg-gradient-to-l from-[#06090e] to-transparent z-10"></div>

          <div
            class="ticker-scroll-track flex items-center gap-4 group-hover:[animation-play-state:paused]"
            style={`--ticker-speed: ${Math.max(18, cryptoTickers.length * 3.5)}s;`}
          >
            <!-- Track 1 -->
            <div class="flex items-center gap-4 shrink-0">
              {cryptoTickers.map((ticker) => {
                const symbolKey = ticker.symbol.toLowerCase();
                return (
                  <div
                    class="flex items-center gap-1 transition-colors duration-300 px-1 py-0.5 rounded shrink-0"
                    data-coin-item={symbolKey}
                  >
                    <span class="text-gray-400 font-semibold">{ticker.name}:</span>
                    <strong class="text-white" data-coin-price={symbolKey}>
                      {ticker.priceFormatted}
                    </strong>
                    <span
                      class={`font-semibold ${ticker.isPositive ? "text-emerald-400" : "text-rose-400"}`}
                      data-coin-change={symbolKey}
                    >
                      {ticker.changeFormatted}
                    </span>
                  </div>
                );
              })}
            </div>
            <!-- Track 2 (Seamless loop copy) -->
            <div class="flex items-center gap-4 shrink-0" aria-hidden="true">
              {cryptoTickers.map((ticker) => {
                const symbolKey = ticker.symbol.toLowerCase();
                return (
                  <div
                    class="flex items-center gap-1 transition-colors duration-300 px-1 py-0.5 rounded shrink-0"
                    data-coin-item={symbolKey}
                  >
                    <span class="text-gray-400 font-semibold">{ticker.name}:</span>
                    <strong class="text-white" data-coin-price={symbolKey}>
                      {ticker.priceFormatted}
                    </strong>
                    <span
                      class={`font-semibold ${ticker.isPositive ? "text-emerald-400" : "text-rose-400"}`}
                      data-coin-change={symbolKey}
                    >
                      {ticker.changeFormatted}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      ) : (
        <!-- Static Flex Mode (<= 5 coins) -->
        <div class="flex items-center gap-3 overflow-x-auto no-scrollbar">
          {cryptoTickers.map((ticker) => {
            const symbolKey = ticker.symbol.toLowerCase();
            return (
              <div
                class="flex items-center gap-1 transition-colors duration-300 px-1 py-0.5 rounded shrink-0"
                data-coin-item={symbolKey}
              >
                <span class="text-gray-400 font-semibold">{ticker.name}:</span>
                <strong class="text-white" data-coin-price={symbolKey}>
                  {ticker.priceFormatted}
                </strong>
                <span
                  class={`font-semibold ${ticker.isPositive ? "text-emerald-400" : "text-rose-400"}`}
                  data-coin-change={symbolKey}
                >
                  {ticker.changeFormatted}
                </span>
              </div>
            );
          })}
        </div>
      )}
    </div>
  </div>
</div>

<!-- 2. MAIN HEADER -->
<header
  class="sticky top-0 z-50 border-b border-white/10 bg-[#0a0e17]/90 backdrop-blur-md"
  data-slot="site-header"
>
  <div class="site-container flex h-16 items-center justify-between gap-4">
    <!-- Brand Logo -->
    <a
      href="/"
      class="flex shrink-0 items-center gap-3 font-bold tracking-tight text-white transition-opacity hover:opacity-90"
      aria-label={`${siteName} — home`}
    >
      <div class="flex size-9 items-center justify-center rounded-lg bg-gradient-to-br from-cyan-400 to-sky-600 text-gray-950 shadow-[0_0_15px_rgba(0,240,255,0.3)]">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
          <path d="M2 12h20"></path>
        </svg>
      </div>
      <div class="text-xl font-extrabold tracking-tight">
        COIN<span class="text-cyan-400">RADAR</span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden lg:flex items-center gap-1">
      <Nav aria-label="Primary" class="gap-1">
        <HeaderNavLinks pathname={pathname} />
      </Nav>
    </div>

    <!-- Right Actions -->
    <div class="flex items-center gap-3">
      <!-- Search Input / Button -->
      <a
        href="/blog/"
        class="hidden sm:inline-flex items-center gap-2 rounded-full border border-white/10 bg-gray-900 px-3.5 py-1.5 text-xs text-gray-400 transition hover:border-cyan-400 hover:text-white"
      >
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <span>Tra cứu scam...</span>
      </a>

      <!-- Report Scam Button -->
      <a
        href="/contact/"
        class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-red-600 to-rose-700 px-4 py-2 text-xs font-bold text-white shadow-[0_0_15px_rgba(239,68,68,0.35)] transition-all hover:scale-[1.02] hover:shadow-[0_0_20px_rgba(239,68,68,0.5)]"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        <span>Báo Cáo Scam</span>
      </a>

      <!-- Mobile Menu Button -->
      <button
        type="button"
        data-dialog-open="site-menu"
        aria-haspopup="dialog"
        aria-controls="site-menu"
        class="flex size-9 items-center justify-center rounded-lg border border-white/10 bg-gray-900 text-gray-300 lg:hidden hover:text-white"
        aria-label="Mở Menu"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Drawer -->
  <Sheet id="site-menu" side="right" aria-labelledby="site-menu-title" class="w-80 border-l border-white/10 bg-[#0c101a] p-6">
    <div class="flex items-center justify-between border-b border-white/10 pb-4 mb-4">
      <span id="site-menu-title" class="text-base font-bold text-white">Menu CoinRadar</span>
      <button
        type="button"
        data-dialog-close
        class="rounded-md p-1.5 text-gray-400 hover:bg-gray-800 hover:text-white"
        aria-label="Đóng Menu"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <Nav orientation="vertical" aria-label="Primary" class="flex flex-col gap-2">
      <HeaderNavLinks pathname={pathname} fullWidth />
    </Nav>
  </Sheet>
</header>

<!-- Coin Selector Modal for Initial Visit & Customization -->
<CoinSelectorModal selectedCoins={selectedCoins} isFirstVisit={isFirstVisit} />

<style>
  @keyframes tickerHorizontalScroll {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .ticker-scroll-track {
    display: flex;
    width: max-content;
    animation: tickerHorizontalScroll var(--ticker-speed, 25s) linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-scroll-track {
      animation: none;
      overflow-x: auto;
    }
  }
</style>

<script>
  // Real-time Binance Price Polling & Animation
  function formatPrice(val: number): string {
    if (val >= 1000) {
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 0,
        maximumFractionDigits: 2,
      }).format(val);
    }
    if (val >= 1) {
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 2,
        maximumFractionDigits: 3,
      }).format(val);
    }
    if (val >= 0.01) {
      return new Intl.NumberFormat("en-US", {
        style: "currency",
        currency: "USD",
        minimumFractionDigits: 2,
        maximumFractionDigits: 4,
      }).format(val);
    }
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: "USD",
      minimumFractionDigits: 4,
      maximumFractionDigits: 8,
    }).format(val);
  }

  const prevPrices: Record<string, number> = {};

  async function updateBinancePrices() {
    const tickerBar = document.getElementById("binance-ticker-bar");
    if (!tickerBar) return;

    const rawPairs = tickerBar.dataset.pairs;
    let pairs: string[] = ["BTCUSDT", "ETHUSDT", "XRPUSDT", "SOLUSDT", "NEARUSDT"];
    try {
      if (rawPairs) pairs = JSON.parse(rawPairs);
    } catch {}

    if (!pairs || pairs.length === 0) return;

    try {
      const url = `https://api.binance.com/api/v3/ticker/24hr?symbols=${encodeURIComponent(
        JSON.stringify(pairs),
      )}`;
      const res = await fetch(url);
      if (!res.ok) return;

      const data = (await res.json()) as Array<{
        symbol: string;
        lastPrice: string;
        priceChangePercent: string;
      }>;

      data.forEach((item) => {
        const symbolKey = item.symbol.replace(/USDT$/, "").toLowerCase();
        const priceEls = document.querySelectorAll(`[data-coin-price="${symbolKey}"]`);
        const changeEls = document.querySelectorAll(`[data-coin-change="${symbolKey}"]`);
        const itemEls = document.querySelectorAll(`[data-coin-item="${symbolKey}"]`);

        const newPrice = parseFloat(item.lastPrice);
        const changePercent = parseFloat(item.priceChangePercent);
        const isPositive = changePercent >= 0;

        priceEls.forEach((el) => {
          el.textContent = formatPrice(newPrice);
        });

        changeEls.forEach((el) => {
          el.textContent = `${isPositive ? "+" : ""}${changePercent.toFixed(2)}%`;
          el.className = `font-semibold ${isPositive ? "text-emerald-400" : "text-rose-400"}`;
        });

        // Trigger flash animation on price change
        if (prevPrices[symbolKey] !== undefined) {
          const oldPrice = prevPrices[symbolKey];
          if (newPrice > oldPrice) {
            itemEls.forEach((el) => {
              el.classList.add("bg-emerald-500/20");
              setTimeout(() => el.classList.remove("bg-emerald-500/20"), 1000);
            });
          } else if (newPrice < oldPrice) {
            itemEls.forEach((el) => {
              el.classList.add("bg-rose-500/20");
              setTimeout(() => el.classList.remove("bg-rose-500/20"), 1000);
            });
          }
        }

        prevPrices[symbolKey] = newPrice;
      });
    } catch {
      // Ignore network errors silently during background polling
    }
  }

  // Initial fetch and poll every 6 seconds
  updateBinancePrices();
  setInterval(updateBinancePrices, 6000);
</script>
