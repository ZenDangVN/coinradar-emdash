{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "coinradar-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "coinradar-emdash-db","database_id": "3d48588b-3eaf-4033-a7dc-85ebdaa73f13",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "coinradar-emdash-media","preview_bucket_name": "coinradar-emdash-media",
		},
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "3bfed446cc2448aca436181ccc429305"
		}
	],
	// Worker Loader for plugin sandboxing
	"worker_loaders": [
		{
			"binding": "LOADER",
		},
	],
	// Drives scheduled publishing, plugin cron, and maintenance (see src/worker.ts)
	"triggers": {
		"crons": ["* * * * *"],
	},
}
